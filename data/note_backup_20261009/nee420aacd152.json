e/n/nee420aacd152","twitter_share_url":"https://twitter.com/intent/tweet?url=https://note.com/sescore/n/nee420aacd152&text=SES%E3%82%A8%E3%83%B3%E3%82%B8%E3%83%8B%E3%82%A2%E3%81%8C%E3%83%95%E3%83%AA%E3%83%BC%E3%83%A9%E3%83%B3%E3%82%B9%E7%8B%AC%E7%AB%8B%E5%89%8D%E3%81%AB%E7%B5%B6%E5%AF%BE%E7%A2%BA%E8%AA%8D%E3%81%99%E3%81%B9%E3%81%8D%E7%A8%8E%E5%8B%99%E3%83%BB%E7%AF%80%E7%A8%8E%E3%81%AE%E5%85%A8%E7%9F%A5%E8%AD%98%E3%80%902026%E5%B9%B4%E6%9C%80%E6%96%B0%E7%89%88%E3%80%91%EF%BD%9CSES%E8%A7%A3%E4%BD%93%E6%96%B0%E6%9B%B8&related=note_PR","note_url":"https://note.com/sescore/n/nee420aacd152","twitter_related_accounts":"note_PR","tweet_text":"SESエンジニアがフリーランス独立前に絶対確認すべき税務・節税の全知識【2026年最新版】｜SES解体新書","circle_plans":[],"is_public_membership_connected":false,"is_board_disabled":false,"discount_campaigns":[],"lead_form":null,"line_add_friend":null,"line_add_friend_note_enable_feature":false,"note_share_total_count":0,"note_share_provider_details":{},"is_published_preview_note":false,"is_ratable":false,"content_rating_via":"","content_raters":[],"my_rating_exists":false,"rater_count":0,"is_recently_purchased":false,"requires_login_for_purchase":false,"is_recently_tip":false,"exclude_from_creator_top":false,"exclude_ai_learning_reward":false,"translation_setting":null,"is_related_with_investment":false,"related_stocks":[],"translation":{"available_languages":["en-US"]}}