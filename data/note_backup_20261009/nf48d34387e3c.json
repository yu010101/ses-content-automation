aw×Claude Code連携を徹底解説｜AI経営OSで開発ワークフローを自動化した全手順【2026年最新】｜SES解体新書","circle_plans":[],"is_public_membership_connected":false,"is_board_disabled":false,"discount_campaigns":[],"lead_form":null,"line_add_friend":null,"line_add_friend_note_enable_feature":false,"note_share_total_count":0,"note_share_provider_details":{},"is_published_preview_note":false,"is_ratable":false,"content_rating_via":"","content_raters":[],"my_rating_exists":false,"rater_count":0,"is_recently_purchased":false,"requires_login_for_purchase":false,"is_recently_tip":false,"exclude_from_creator_top":false,"exclude_ai_learning_reward":false,"translation_setting":null,"is_related_with_investment":false,"related_stocks":[],"translation":{"available_languages":[]}}