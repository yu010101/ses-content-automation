B%E3%82%92%E8%BA%AB%E3%81%AB%E3%81%A4%E3%81%91%E3%81%A6%E5%8D%98%E4%BE%A1%E3%82%92%E4%B8%8A%E3%81%92%E3%81%9F%E8%A9%B1%E3%80%902026%E5%B9%B4%E7%89%88%E3%80%91%EF%BD%9CSES%E8%A7%A3%E4%BD%93%E6%96%B0%E6%9B%B8&related=note_PR","note_url":"https://note.com/sescore/n/n04d78949fcf3","twitter_related_accounts":"note_PR","tweet_text":"SESエンジニアがClaude Codeでデータ分析スキルを身につけて単価を上げた話【2026年版】｜SES解体新書","circle_plans":[],"is_public_membership_connected":false,"is_board_disabled":false,"discount_campaigns":[],"lead_form":null,"line_add_friend":null,"line_add_friend_note_enable_feature":false,"note_share_total_count":0,"note_share_provider_details":{},"is_published_preview_note":false,"is_ratable":false,"content_rating_via":"","content_raters":[],"my_rating_exists":false,"rater_count":0,"is_recently_purchased":false,"requires_login_for_purchase":false,"is_recently_tip":false,"exclude_from_creator_top":false,"exclude_ai_learning_reward":false,"translation_setting":null,"is_related_with_investment":false,"related_stocks":[],"translation":{"available_languages":[]}}